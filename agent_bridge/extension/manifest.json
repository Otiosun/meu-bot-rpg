{
  "manifest_version": 3,
  "name": "Clover Agent Wake Bridge (POC)",
  "version": "0.1.0",
  "description": "Acorda uma conversa dedicada do ChatGPT quando há perguntas PENDING no Clover Agent.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
